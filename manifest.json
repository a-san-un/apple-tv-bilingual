{
  "manifest_version": 3,
  "name": "Apple TV+ Bilingual Subtitles",
  "version": "2.6.3",
  "description": "Displays bilingual subtitles with a right panel and dictionary popup on Apple TV+",
  "permissions": ["storage", "tabs", "scripting", "downloads"],
  "host_permissions": [
    "https://tv.apple.com/*",
    "https://jisho.org/*",
    "https://translate.googleapis.com/*",
    "https://api.tatoeba.org/*",
    "https://api.dictionaryapi.dev/*"
  ],
  "background": {
    "service_worker": "background.js"
  },
  "content_scripts": [
    {
      "matches": ["https://tv.apple.com/*"],
      "js": [
        "vtt-normalizer.js",
        "debug-logger.js",
        "subtitle-track-resolver.js",
        "settings-bridge.js",
        "debug-panel.js",
        "panel-renderer.js",
        "panel-ui.js",
        "subtitle-blocks.js",
        "subtitle-block-resolver.js",
        "overlay-block-resolver.js",
        "subtitle-view-resolver.js",
        "secondary-subtitle-dom.js",
        "initial-cue-recovery.js",
        "cue-controller.js",
        "overlay-controller.js",
        "runtime-observers.js",
        "playback-controls-layout.js",
        "modules/playback-controls-layout-controller.js",
        "settings-runtime.js",
        "modules/playback-context-controller.js",
        "reinitialize-coordinator.js",
        "sync-interval-orchestrator.js",
        "content.js"
      ],
      "css": ["overlay.css"],
      "run_at": "document_idle"
    }
  ],
  "web_accessible_resources": [
  {
    "resources": ["dict/ejdict.json", "panel.css"],
    "matches": ["https://tv.apple.com/*"]
  }
],
  "action": {
    "default_popup": "popup.html",
    "default_title": "ATV Bilingual"
  },
  "options_ui": {
    "page": "options.html",
    "open_in_tab": true
  }
}