{
  "manifest_version": 3,
  "name": "Apple TV+ Bilingual Subtitles",
  "version": "2.6.0",
  "description": "Displays bilingual subtitles with right panel and dictionary popup on Apple TV+",
  "permissions": ["storage", "tabs", "scripting"],
  "host_permissions": [
    "https://tv.apple.com/*",
    "https://jisho.org/*",
    "https://translate.googleapis.com/*",
    "https://api.tatoeba.org/*",
    "https://api.dictionaryapi.dev/*"
  ],
  "background": {
    "service_worker": "background.js"
  },
  "content_scripts": [
    {
      "matches": ["https://tv.apple.com/*"],
      "js": ["content.js"],
      "css": ["overlay.css"],
      "run_at": "document_idle"
    }
  ],
  "web_accessible_resources": [
    {
      "resources": ["dict/ejdict.json"],
      "matches": ["https://tv.apple.com/*"]
    }
  ],
  "action": {
    "default_popup": "popup.html",
    "default_title": "ATV Bilingual"
  },
  "options_ui": {
    "page": "options.html",
    "open_in_tab": true
  }
}
