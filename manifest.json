{
  "manifest_version": 3,
  "name": "Apple TV+ Bilingual Subtitles",
  "version": "0.1.0",
  "description": "Display dual subtitles on Apple TV+ with dictionary popup and AI translation",
  "permissions": ["storage"],
  "host_permissions": ["https://tv.apple.com/*"],
  "content_scripts": [{
    "matches": ["https://tv.apple.com/*"],
    "js": ["content.js"],
    "css": ["overlay.css"],
    "run_at": "document_idle"
  }],
  "action": {
    "default_popup": "popup.html",
    "default_title": "ATV Bilingual"
  }
}
